#!/bin/sh
#
# Reject a commit message that does not follow the convention - PF-001.
#
# ## Why a hook and not only a CI check
#
# A CI check tells you the message is wrong after the commit exists, and the
# only fix is to rewrite history - which CONTRIBUTING.md forbids on a shared
# branch. So the check has to run before the commit is written, and the only
# place that happens is here.
#
# ## POSIX sh, and no dependencies
#
# It runs on every developer's machine, including the one with no bash, no
# node and no composer vendor directory. `grep -E` and `case` are all it uses.
#
# Installed by `composer setup`, which points `core.hooksPath` at this
# directory rather than copying the file - a copy goes stale the moment the
# hook changes, and nobody re-runs the installer.
set -eu

MESSAGE_FILE="$1"
SUBJECT=$(head -n 1 "$MESSAGE_FILE")

# The types in use, which CONTRIBUTING.md lists and a check asserts match.
TYPES='feat|fix|refactor|perf|test|docs|build|ci|chore|revert'

fail() {
    printf '\n\033[31mThis commit message was refused.\033[0m\n\n'
    printf '  %s\n\n' "$1"
    printf 'The convention (CONTRIBUTING.md):\n\n'
    printf '  feat(ledger): enforce the balanced-entry invariant as a deferred constraint\n\n'
    printf '  Refs PF-043\n\n'
    printf 'Types: %s. The scope is the module.\n' "$(printf '%s' "$TYPES" | tr '|' ' ')"
    printf 'Your subject was:\n\n  %s\n\n' "$SUBJECT"
    exit 1
}

# Git's own messages, and the ones a rebase will fold away, pass through.
case "$SUBJECT" in
    'Merge '*|'Revert "'*|'fixup!'*|'squash!'*|'amend!'*)
        exit 0
        ;;
esac

# An empty message is git's own business - it aborts the commit itself.
if [ -z "$(printf '%s' "$SUBJECT" | tr -d '[:space:]')" ]; then
    exit 0
fi

# A comment-only file is an aborted commit.
case "$SUBJECT" in
    '#'*) exit 0 ;;
esac

if ! printf '%s' "$SUBJECT" | grep -Eq "^($TYPES)(\([a-z0-9-]+\))?!?: .+"; then
    fail 'The subject must be `type(scope): summary`, with a type from the list below.'
fi

SUMMARY=$(printf '%s' "$SUBJECT" | sed -E "s/^($TYPES)(\([a-z0-9-]+\))?!?: //")

if [ "${#SUBJECT}" -gt 72 ]; then
    fail "The subject is ${#SUBJECT} characters; keep it to 72 so `git log --oneline` stays readable."
fi

# A subject starting with a capital reads as a sentence and then has no full
# stop, which looks like a mistake rather than a convention.
case "$SUMMARY" in
    [A-Z]*)
        # An acronym or an identifier is fine: PF-043, SQL, RFC 9457.
        if ! printf '%s' "$SUMMARY" | grep -Eq '^([A-Z0-9]{2,}|PF-[0-9]+)'; then
            fail 'Start the summary in lower case, unless it begins with an acronym or an identifier.'
        fi
        ;;
esac

case "$SUMMARY" in
    *.)
        fail 'Drop the full stop. The subject is a title, not a sentence.'
        ;;
esac

# The second line must be blank, or `git log` runs the subject into the body.
SECOND=$(sed -n '2p' "$MESSAGE_FILE")

if [ -n "$(printf '%s' "$SECOND" | tr -d '[:space:]')" ]; then
    fail 'Leave the second line blank. Without it the body runs into the subject in every log view.'
fi

# A commit that changes behaviour names its task. `docs`, `chore`, `ci`,
# `build`, `test` and `revert` do not have to: a typo fix with a task number
# is paperwork, and paperwork that is required is paperwork that gets faked.
TYPE=$(printf '%s' "$SUBJECT" | sed -E 's/^([a-z]+).*/\1/')

case "$TYPE" in
    feat|fix|refactor|perf)
        if ! grep -Eq '(^|[^A-Za-z])PF-[0-9]{3}' "$MESSAGE_FILE"; then
            fail "A $TYPE commit changes behaviour, so it references its task: add a \`Refs PF-###\` line."
        fi
        ;;
esac

exit 0
