<?xml version="1.0" encoding="UTF-8"?>
<!--
  An intraday report that STATES its balances.

  The interesting case for continuity. An MT942 carries no balances at all,
  so the importer opens and closes it where the account already stands and it
  is transparent to the chain whatever the rules say. A CAMT.052 may carry
  ITBD balances of its own - and they are not the last booked closing, so a
  continuity chain that counted this would refuse the next real statement.
-->
<Document xmlns="urn:iso:std:iso:20022:tech:xsd:camt.052.001.08">
  <BkToCstmrAcctRpt>
    <GrpHdr>
      <MsgId>RJHI-INTRADAY-0511</MsgId>
      <CreDtTm>2026-05-11T14:30:00+03:00</CreDtTm>
    </GrpHdr>
    <Rpt>
      <Id>INTRADAY-2026-05-11</Id>
      <Acct>
        <Id><IBAN>SA0380000000608010167519</IBAN></Id>
        <Ccy>SAR</Ccy>
      </Acct>
      <FrToDt>
        <FrDtTm>2026-05-11T00:00:00+03:00</FrDtTm>
        <ToDtTm>2026-05-11T14:30:00+03:00</ToDtTm>
      </FrToDt>

      <Bal>
        <Tp><CdOrPrtry><Cd>ITBD</Cd></CdOrPrtry></Tp>
        <Amt Ccy="SAR">51500.00</Amt>
        <CdtDbtInd>CRDT</CdtDbtInd>
      </Bal>
      <Bal>
        <Tp><CdOrPrtry><Cd>CLBD</Cd></CdOrPrtry></Tp>
        <Amt Ccy="SAR">53280.00</Amt>
        <CdtDbtInd>CRDT</CdtDbtInd>
      </Bal>

      <Ntry>
        <Amt Ccy="SAR">1780.00</Amt>
        <CdtDbtInd>CRDT</CdtDbtInd>
        <Sts><Cd>BOOK</Cd></Sts>
        <BookgDt><Dt>2026-05-11</Dt></BookgDt>
        <ValDt><Dt>2026-05-11</Dt></ValDt>
        <AcctSvcrRef>RJHI-INTRA-0001</AcctSvcrRef>
        <NtryDtls>
          <TxDtls>
            <Amt Ccy="SAR">1780.00</Amt>
            <RltdPties><Dbtr><Nm>Coastal Trading</Nm></Dbtr></RltdPties>
            <RmtInf><Ustrd>INV-1099</Ustrd></RmtInf>
          </TxDtls>
        </NtryDtls>
      </Ntry>
    </Rpt>
  </BkToCstmrAcctRpt>
</Document>
