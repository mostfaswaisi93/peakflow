      "type": "liability",
      "name_ar": "الالتزامات المتداولة",
      "name_en": "Current liabilities",
      "postable": false,
      "role": null,
      "monetary": false
    },
    {
      "code": "2.1.1",
      "parent": "2.1",
      "type": "liability",
      "name_ar": "ذمم الموردين",
      "name_en": "Trade payables",
      "postable": true,
      "role": "accounts_payable",
      "monetary": true
    },
    {
      "code": "2.1.2",
      "parent": "2.1",
      "type": "liability",
      "name_ar": "ضريبة المبيعات العامة المخرجة",
      "name_en": "Output general sales tax",
      "postable": true,
      "role": "vat_output",
      "monetary": true
    },
    {
      "code": "2.1.3",
      "parent": "2.1",
      "type": "liability",
      "name_ar": "إيرادات مؤجلة",
      "name_en": "Deferred revenue",
      "postable": true,
      "role": "deferred_revenue",
      "monetary": false,
      "note": "NOT monetary. Deferred revenue is settled by delivering goods and services, not by paying money, so restating it at the closing rate puts an exchange difference through profit or loss for an obligation that is not denominated in currency. It is the account most often wrongly marked monetary."
    },
    {
      "code": "2.1.4",
      "parent": "2.1",
      "type": "liability",
      "name_ar": "ضريبة المبيعات المستحقة للدائرة",
      "name_en": "General sales tax payable to the ISTD",
      "postable": true,
      "role": null,
      "monetary": true,
      "note": "The net settlement account for a sales tax period, so a filed return and an unfiled one are different balances rather than the same one read differently."
    },
    {
      "code": "2.1.5",
      "parent": "2.1",
      "type": "liability",
      "name_ar": "ضريبة الدخل المستحقة",
      "name_en": "Income tax provision",
      "postable": true,
      "role": null,
      "monetary": true
    },
    {
      "code": "2.1.6",
      "parent": "2.1",
      "type": "liability",
      "name_ar": "ضريبة المساهمة الوطنية المستحقة",
      "name_en": "National contribution tax payable",
      "postable": true,
      "role": null,
      "monetary": true,
      "note": "Separate from income tax because it is assessed separately and on sectors rather than on all entities. Folded into the income tax provision it would be unreportable."
    },
    {
      "code": "2.1.7",
      "parent": "2.1",
      "type": "liability",
      "name_ar": "ضريبة مقتطعة مستحقة",
      "name_en": "Tax withheld at source, payable",
      "postable": true,
      "role": "withholding_payable",
      "monetary": true,
      "note": "Withholding we deducted from payments to suppliers and owe to the authority. The supplier's invoice is settled in full; this is the part that goes to the authority instead of to them."
    },
    {
      "code": "2.1.8",
