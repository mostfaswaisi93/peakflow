      "monetary": true
    },
    {
      "code": "1.1.2",
      "parent": "1.1",
      "type": "asset",
      "name_ar": "الذمم المدينة",
      "name_en": "Receivables",
      "postable": false,
      "role": null,
      "monetary": false
    },
    {
      "code": "1.1.2.1",
      "parent": "1.1.2",
      "type": "asset",
      "name_ar": "ذمم العملاء",
      "name_en": "Trade receivables",
      "postable": true,
      "role": "accounts_receivable",
      "monetary": true
    },
    {
      "code": "1.1.2.2",
      "parent": "1.1.2",
      "type": "asset",
      "name_ar": "مخصص الخسائر الائتمانية",
      "name_en": "Expected credit loss provision",
      "postable": true,
      "role": "ecl_provision",
      "monetary": true,
      "note": "Monetary, and a credit balance on an asset. It is the provision against trade receivables (IFRS 9 expected credit losses), not a separate pool of money."
    },
    {
      "code": "1.1.3",
      "parent": "1.1",
      "type": "asset",
      "name_ar": "ضريبة المبيعات العامة المدخلة",
      "name_en": "Input general sales tax",
      "postable": true,
      "role": "vat_input",
      "monetary": true,
      "note": "The same control role as Input VAT elsewhere. Jordan's tax is a general sales tax with its own name, rate and return, and nothing in the posting rules has to know that."
    },
    {
      "code": "1.1.4",
      "parent": "1.1",
      "type": "asset",
      "name_ar": "حسابات وسيطة",
      "name_en": "Suspense",
      "postable": true,
      "role": "suspense",
      "monetary": false,
      "note": "NOT monetary. Suspense holds items nobody has identified yet, and revaluing an unidentified item asserts a classification that has not been made."
    },
    {
      "code": "1.1.5",
      "parent": "1.1",
      "type": "asset",
      "name_ar": "حسابات جارية بين الشركات",
      "name_en": "Inter-entity",
      "postable": true,
      "role": "inter_entity",
      "monetary": true
    },
    {
      "code": "1.1.6",
      "parent": "1.1",
      "type": "asset",
      "name_ar": "الضريبة المحتجزة من مستحقاتنا",
      "name_en": "Tax withheld at source, receivable",
      "postable": true,
      "role": "withholding_receivable",
      "monetary": true,
      "note": "Withholding deducted by our customers from payments to us - a credit we claim against our own liability, which is an asset until the return that claims it. PF-083 records the certificate; this is where the credit sits."
    },
    {
      "code": "1.2",
      "parent": "1",
      "type": "asset",
      "name_ar": "الأصول غير المتداولة",
      "name_en": "Non-current assets",
      "postable": false,
      "role": null,
      "monetary": false
    },
    {
      "code": "1.2.1",
      "parent": "1.2",
      "type": "asset",
      "name_ar": "الممتلكات والمعدات",
      "name_en": "Property, plant and equipment",
      "postable": true,
      "role": null,
      "monetary": false,
      "note": "NOT monetary under IAS 21: property is carried at its historical rate, unlike the receivable sitting two groups above it. Both are assets, which is why the classification cannot be derived from the type."
    },
    {
      "code": "2",
