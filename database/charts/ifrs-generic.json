    },
    {
      "code": "1.1.2",
      "parent": "1.1",
      "type": "asset",
      "name_ar": "الذمم المدينة",
      "name_en": "Receivables",
      "postable": false,
      "role": null,
      "monetary": false
    },
    {
      "code": "1.1.2.1",
      "parent": "1.1.2",
      "type": "asset",
      "name_ar": "ذمم العملاء",
      "name_en": "Trade receivables",
      "postable": true,
      "role": "accounts_receivable",
      "monetary": true
    },
    {
      "code": "1.1.2.2",
      "parent": "1.1.2",
      "type": "asset",
      "name_ar": "مخصص الخسائر الائتمانية",
      "name_en": "Expected credit loss provision",
      "postable": true,
      "role": "ecl_provision",
      "monetary": true,
      "note": "Monetary, and a credit balance on an asset. It is the provision against trade receivables (IFRS 9 expected credit losses), not a separate pool of money."
    },
    {
      "code": "1.1.3",
      "parent": "1.1",
      "type": "asset",
      "name_ar": "ضريبة القيمة المضافة المدخلة",
      "name_en": "Input VAT",
      "postable": true,
      "role": "vat_input",
      "monetary": true
    },
    {
      "code": "1.1.4",
      "parent": "1.1",
      "type": "asset",
      "name_ar": "حسابات وسيطة",
      "name_en": "Suspense",
      "postable": true,
      "role": "suspense",
      "monetary": false,
      "note": "NOT monetary. Suspense holds items nobody has identified yet, and revaluing an unidentified item asserts a classification that has not been made."
    },
    {
      "code": "1.1.5",
      "parent": "1.1",
      "type": "asset",
      "name_ar": "حسابات جارية بين الشركات",
      "name_en": "Inter-entity",
      "postable": true,
      "role": "inter_entity",
      "monetary": true
    },
    {
      "code": "1.1.6",
      "parent": "1.1",
      "type": "asset",
      "name_ar": "ضريبة الاستقطاع المحتجزة من مستحقاتنا",
      "name_en": "Withholding tax receivable",
      "postable": true,
      "role": "withholding_receivable",
      "monetary": true,
      "note": "Withholding deducted by our customers from payments to us - a credit we claim against our own liability, which is an asset until the return that claims it. PF-083 records the certificate; this is where the credit sits."
    },
    {
      "code": "1.1.7",
      "parent": "1.1",
      "type": "asset",
      "name_ar": "المخزون",
      "name_en": "Inventory",
      "postable": true,
      "role": "inventory",
      "monetary": false,
      "note": "NOT monetary. Suspense holds items nobody has identified yet, and revaluing an unidentified item asserts a classification that has not been made."
    },
    {
      "code": "1.2",
      "parent": "1",
      "type": "asset",
      "name_ar": "الأصول غير المتداولة",
      "name_en": "Non-current assets",
      "postable": false,
      "role": null,
      "monetary": false
    },
    {
      "code": "1.2.1",
      "parent": "1.2",
      "type": "asset",
      "name_ar": "الممتلكات والمعدات",
      "name_en": "Property, plant and equipment",
      "postable": true,
      "role": null,
      "monetary": false,
      "note": "NOT monetary under IAS 21: property is carried at its historical rate, unlike the receivable sitting two groups above it. Both are assets, which is why the classification cannot be derived from the type."
    },
    {
      "code": "2",
      "parent": null,
      "type": "liability",
      "name_ar": "الالتزامات",
      "name_en": "Liabilities",
      "postable": false,
      "role": null,
      "monetary": false
    },
    {
      "code": "2.1",
      "parent": "2",
      "type": "liability",
      "name_ar": "الالتزامات المتداولة",
      "name_en": "Current liabilities",
      "postable": false,
      "role": null,
      "monetary": false
    },
    {
      "code": "2.1.1",
      "parent": "2.1",
      "type": "liability",
      "name_ar": "ذمم الموردين",
      "name_en": "Trade payables",
      "postable": true,
      "role": "accounts_payable",
      "monetary": true
    },
    {
      "code": "2.1.2",
      "parent": "2.1",
      "type": "liability",
      "name_ar": "ضريبة القيمة المضافة المخرجة",
      "name_en": "Output VAT",
      "postable": true,
      "role": "vat_output",
      "monetary": true
    },
    {
      "code": "2.1.3",
      "parent": "2.1",
      "type": "liability",
      "name_ar": "إيرادات مؤجلة",
      "name_en": "Deferred revenue",
      "postable": true,
      "role": "deferred_revenue",
      "monetary": false,
      "note": "NOT monetary. Deferred revenue is settled by delivering goods and services, not by paying money, so restating it at the closing rate puts an exchange difference through profit or loss for an obligation that is not denominated in currency. It is the account most often wrongly marked monetary."
    },
    {
      "code": "2.1.4",
      "parent": "2.1",
      "type": "liability",
      "name_ar": "ضريبة الاستقطاع المستحقة الدفع",
      "name_en": "Withholding tax payable",
      "postable": true,
      "role": "withholding_payable",
      "monetary": true,
      "note": "Withholding we deducted from payments to suppliers and owe to the authority. The supplier's invoice is settled in full; this is the part that goes to the authority instead of to them."
    },
    {
      "code": "2.1.5",
      "parent": "2.1",
      "type": "liability",
      "name_ar": "بضاعة مستلمة غير مفوترة",
      "name_en": "Goods received not invoiced",
      "postable": true,
      "role": "goods_received_not_invoiced",
      "monetary": true,
      "note": "PF-132: a liability for things that have arrived and whose bill has not. What makes a period-end cutoff honest, and a balance that does not clear is a receipt nobody was ever billed for."
    },
    {
      "code": "2.1.6",
      "parent": "2.1",
      "type": "liability",
      "name_ar": "مستحقات للعاملين",
      "name_en": "Employee payables",
      "postable": true,
      "role": "employee_payable",
      "monetary": true,
      "note": "PF-143: what the business owes its own people. An employee is not a supplier - the balance is reported differently, it is frequently settled through payroll, and an aging report that mixed the two would show a colleague's taxi fare beside a supplier on thirty-day terms."
    },
    {
      "code": "2.1.7",
      "parent": "2.1",
      "type": "liability",
      "name_ar": "مقبوضات غير مخصّصة",
      "name_en": "Unapplied cash",
      "postable": true,
      "role": "unapplied_cash",
      "monetary": false,
      "note": "NOT monetary. Deferred revenue is settled by delivering goods and services, not by paying money, so restating it at the closing rate puts an exchange difference through profit or loss for an obligation that is not denominated in currency. It is the account most often wrongly marked monetary."
    },
