    {
      "code": "2.1.3",
      "parent": "2.1",
      "type": "liability",
      "name_ar": "إيرادات مؤجلة",
      "name_en": "Deferred revenue",
      "postable": true,
      "role": "deferred_revenue",
      "monetary": false,
      "note": "NOT monetary. Deferred revenue is settled by delivering goods and services, not by paying money, so restating it at the closing rate puts an exchange difference through profit or loss for an obligation that is not denominated in currency. It is the account most often wrongly marked monetary."
    },
    {
      "code": "2.1.4",
      "parent": "2.1",
      "type": "liability",
      "name_ar": "ضريبة القيمة المضافة المستحقة للهيئة",
      "name_en": "VAT payable to ZATCA",
      "postable": true,
      "role": null,
      "monetary": true,
      "note": "The net settlement account for a VAT period. Input and output VAT are the two control accounts the tax engine posts to; this is where the period's net moves when the return is filed, so a filed return and an unfiled one are different balances rather than the same one read differently."
    },
    {
      "code": "2.1.5",
      "parent": "2.1",
      "type": "liability",
      "name_ar": "الزكاة المستحقة",
      "name_en": "Zakat provision",
      "postable": true,
      "role": null,
      "monetary": true
    },
    {
      "code": "2.1.6",
      "parent": "2.1",
      "type": "liability",
      "name_ar": "ضريبة الدخل المستحقة",
      "name_en": "Income tax provision",
      "postable": true,
      "role": null,
      "monetary": true,
      "note": "Separate from Zakat, and both exist on one entity: a mixed company apportions between the Saudi/GCC-owned share, which bears Zakat, and the rest, which bears income tax. One combined account cannot produce either filing."
    },
    {
      "code": "2.1.7",
      "parent": "2.1",
      "type": "liability",
      "name_ar": "ضريبة الاستقطاع المستحقة",
      "name_en": "Withholding tax payable",
      "postable": true,
      "role": "withholding_payable",
      "monetary": true,
      "note": "Withholding we deducted from payments to suppliers and owe to the authority. The supplier's invoice is settled in full; this is the part that goes to the authority instead of to them."
    },
    {
      "code": "2.1.8",
