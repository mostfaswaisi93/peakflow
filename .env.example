# =============================================================================
#  PeakFlow — environment
# =============================================================================
#  A fresh clone must work with NOTHING but this file copied to .env.
#  EXCHANGE_DRIVER=log and PDF_DRIVER=stub are the committed defaults so that
#  an invoice can be issued end to end with no Peppol credentials, no clearance
#  certificate and no PDF service. See PF-012 and PF-229.
# =============================================================================

APP_NAME=PeakFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Arabic-first. `en` is the fallback, never the default.
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_JO

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
#  Databases
# -----------------------------------------------------------------------------
#  PostgreSQL is REQUIRED, not preferred. The tenant schema uses deferrable
#  constraint triggers, row-level security and declarative partitioning; the
#  ledger's invariants live there rather than in application code. See ADR-0002.
#
#  `platform` is the operator's own database.
#  `tenant` is a template whose settings are REWRITTEN PER REQUEST to point at
#  the resolved tenant's own database. Never put real credentials on it.
DB_CONNECTION=platform

DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=peakflow
DB_USERNAME=peakflow_app
DB_PASSWORD=

#  Migrations run as a DIFFERENT role from a different process. The application
#  role cannot ALTER, cannot DROP, and cannot DELETE a posted financial row.
#  See PF-010 and PF-233.
DB_MIGRATOR_USERNAME=peakflow_migrator
DB_MIGRATOR_PASSWORD=

#  Tenant provisioning: `create` issues CREATE DATABASE / CREATE ROLE / GRANT.
#  `link` attaches a pre-created database, for managed hosting without those
#  privileges. The mode is recorded per tenant because the restore procedure
#  differs between them. See PF-019 and PF-020.
TENANCY_PROVISION_MODE=create
TENANCY_DATABASE_PREFIX=peakflow_t_
TENANCY_MIGRATE_CONCURRENCY=4

# -----------------------------------------------------------------------------
#  Cache, queue, session
# -----------------------------------------------------------------------------
#  A SHARED store is required in production: the Redis locks keyed on
#  (task, tenant, occurrence) are what stop a two-node scheduler from
#  double-billing a customer. Under the `array` store that degrades to a no-op.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
#  Money
# -----------------------------------------------------------------------------
#  Scales are NOT configurable - exactly three exist and an architecture test
#  fails a migration that introduces a fourth. What is configurable is the
#  rounding policy, because it is written into law and differs by jurisdiction.
#
#  EN 16931 and most VAT regimes specify HALF_UP (half away from zero), not the
#  half-even that IEEE 754 and most language defaults use.
MONEY_DEFAULT_ROUNDING=half_up
MONEY_TAX_GROUPING=per_rate_group

# -----------------------------------------------------------------------------
#  Tax
# -----------------------------------------------------------------------------
#  Ceilings the operator sets and a tenant may lower but never raise.
TAX_WRITEOFF_TOLERANCE_CEILING=50.0000
TAX_ROUNDING_TOLERANCE_CEILING=1.0000

# -----------------------------------------------------------------------------
#  Banking
# -----------------------------------------------------------------------------
#  Nothing above the ceiling can be auto-applied, whatever a tenant configures.
BANKING_AUTOMATCH_CONFIDENCE_CEILING=0.95
BANKING_SUBSET_SUM_CANDIDATE_CAP=24
BANKING_SUBSET_SUM_TIME_BUDGET_MS=500

# -----------------------------------------------------------------------------
#  Exchange — outbound and inbound documents
# -----------------------------------------------------------------------------
#  `log` writes the document that WOULD have been transmitted into the log and
#  marks the transmission succeeded, so the full state machine is exercised
#  without a third party. Switching to a real driver is configuration, not a
#  different code path - asserted by running the same test against both.
EXCHANGE_DRIVER=log
EXCHANGE_RETRY_MAX=8
# The address a supplier emails an invoice to: inbox+<entity code>@<domain>.
# The address is the only thing that decides which entity's queue it joins -
# PF-140.
EXCHANGE_INTAKE_DOMAIN=invoices.peakflow.test
EXCHANGE_INTAKE_MAILBOX=inbox

# Document extraction - PF-142. `none` is a declared absence, not a stub: a
# PDF carrying embedded XML is still read exactly, and a scan is recorded as
# unavailable with the reason rather than read by an invented engine.
EXTRACTION_DRIVER=none
EXTRACTION_REVIEW_BELOW=0.90
EXCHANGE_CIRCUIT_BREAKER_THRESHOLD=5

# Peppol — only read when EXCHANGE_DRIVER=peppol.
PEPPOL_ACCESS_POINT_URL=
PEPPOL_SML_DOMAIN=

# ZATCA — only read when a ZATCA profile is enabled for an entity.
# The signing key lives in a KMS. This is a REFERENCE, never a key.
ZATCA_ENVIRONMENT=sandbox
ZATCA_KMS_KEY_REFERENCE=

# -----------------------------------------------------------------------------
#  Documents
# -----------------------------------------------------------------------------
#  `stub` renders an HTML placeholder. `gotenberg` renders real PDF/A-3, and
#  veraPDF VERIFIES conformance - a non-conformant output fails the job rather
#  than being delivered, because a PDF that merely claims PDF/A is not an
#  archive copy. See PF-102.
PDF_DRIVER=stub
GOTENBERG_URL=http://127.0.0.1:3000
VERAPDF_BINARY=verapdf

FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
#  Session, and the three settings whose wrong value is silent
# -----------------------------------------------------------------------------
#  All three are set EXPLICITLY here because the Laravel skeleton leaves them
#  unset, and unset is the unsafe answer for two of them. A production
#  deployment is refused at boot if any of them is wrong - see
#  App\Support\Config\ProductionConfiguration and
#  docs/operations/configuration.md.
#
#  SESSION_SECURE_COOKIE is `false` HERE and must be `true` in production. It
#  cannot be true locally: a browser will not send a secure cookie over
#  http://localhost, so nobody could sign in, and the symptom is a login form
#  that keeps reloading rather than anything mentioning cookies.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

#  Sessions live in the PLATFORM database, which no row-level security policy
#  covers - the policies are per tenant database - and the payload holds the
#  entity context and the second-factor assertion time. Together those answer
#  "who was allowed to release a payment, and when".
SESSION_ENCRYPT=true

# -----------------------------------------------------------------------------
#  Foreign exchange
# -----------------------------------------------------------------------------
#  The peg provider is static and needs nothing. A primary HTTP feed is OFF
#  unless FX_PRIMARY_URL is set: a feed with no URL would fail on every run and
#  fill the audit log with alerts about a provider nobody configured.
#
#  The key goes in a header, never in the URL - a URL ends up in an access log,
#  an error report and a browser history.
FX_PRIMARY_URL=
FX_PRIMARY_RATES_PATH=rates
FX_PRIMARY_TIMEOUT=10
FX_PRIMARY_KEY=

#  How far back a stale rate may be reused when every provider is down. Past
#  this the pair is unresolved, because "the last known rate" from eleven
#  months ago is not resilience - it is a wrong number with a long paper trail.
FX_FALLBACK_WINDOW_DAYS=30

# -----------------------------------------------------------------------------
#  Build
# -----------------------------------------------------------------------------
#  Read by vite.config.js at build time, not by any config file. See the
#  SET-ONLY note at the end of this file.
PEAKFLOW_FETCH_FONTS=0

# -----------------------------------------------------------------------------
#  Search
# -----------------------------------------------------------------------------
SCOUT_DRIVER=null
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# -----------------------------------------------------------------------------
#  Mail
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS="noreply@peakflow.test"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
#  Observability
# -----------------------------------------------------------------------------
#  Logs are built from an ALLOWLIST of permitted fields, never a redaction
#  blocklist - a blocklist fails open the first time someone adds a field, and
#  the field that gets added is an IBAN. See PF-014.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

TELEMETRY_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=0.1

# =============================================================================
#  Framework keys deliberately left at Laravel's defaults
# =============================================================================
#  `bin/verify config` requires every env() key that a config file reads to be
#  either SET above or NAMED here. That is the point of this block: leaving a
#  key out becomes a visible decision in a diff rather than an omission nobody
#  can distinguish from an oversight.
#
#  Everything below is a driver PeakFlow does not use (memcached, DynamoDB,
#  SQS, Beanstalkd, Pusher, S3, Postmark, Resend, Papertrail) or a skeleton
#  default that is correct as it stands. Setting them to their own defaults
#  would add ninety lines that say nothing.
#
#  A key that moves OUT of this list and into the file above is a decision to
#  own its value. A key that moves INTO it is a decision to stop.
#
# UNUSED: APP_SUPPORT_EMAIL APP_PREVIOUS_KEYS APP_MAINTENANCE_STORE
# UNUSED: AUTH_GUARD AUTH_PASSWORD_BROKER AUTH_MODEL AUTH_PASSWORD_RESET_TOKEN_TABLE AUTH_PASSWORD_TIMEOUT
# UNUSED: DB_CACHE_CONNECTION DB_CACHE_TABLE DB_CACHE_LOCK_CONNECTION DB_CACHE_LOCK_TABLE
# UNUSED: CACHE_STORAGE_DISK CACHE_STORAGE_PATH CACHE_PREFIX
# UNUSED: MEMCACHED_PERSISTENT_ID MEMCACHED_USERNAME MEMCACHED_PASSWORD MEMCACHED_HOST MEMCACHED_PORT
# UNUSED: DYNAMODB_CACHE_TABLE DYNAMODB_ENDPOINT
# UNUSED: REDIS_CACHE_CONNECTION REDIS_CACHE_LOCK_CONNECTION REDIS_CLUSTER REDIS_PREFIX
# UNUSED: REDIS_PERSISTENT REDIS_URL REDIS_USERNAME REDIS_DB REDIS_CACHE_DB REDIS_LOCK_DB
# UNUSED: REDIS_QUEUE_CONNECTION REDIS_QUEUE REDIS_QUEUE_RETRY_AFTER
# UNUSED: DB_URL DB_CHARSET
# UNUSED: AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_DEFAULT_REGION AWS_BUCKET AWS_URL AWS_ENDPOINT AWS_USE_PATH_STYLE_ENDPOINT
# UNUSED: POSTMARK_API_KEY POSTMARK_MESSAGE_STREAM_ID RESEND_API_KEY
# UNUSED: SLACK_BOT_USER_OAUTH_TOKEN SLACK_BOT_USER_DEFAULT_CHANNEL
# UNUSED: LOG_DEPRECATIONS_CHANNEL LOG_DEPRECATIONS_TRACE LOG_DAILY_DAYS
# UNUSED: LOG_SLACK_WEBHOOK_URL LOG_SLACK_USERNAME LOG_SLACK_EMOJI
# UNUSED: LOG_PAPERTRAIL_HANDLER PAPERTRAIL_URL PAPERTRAIL_PORT LOG_STDERR_FORMATTER LOG_SYSLOG_FACILITY
# UNUSED: MAIL_SCHEME MAIL_URL MAIL_USERNAME MAIL_PASSWORD MAIL_EHLO_DOMAIN MAIL_SENDMAIL_PATH MAIL_LOG_CHANNEL
# UNUSED: DB_QUEUE_CONNECTION DB_QUEUE_TABLE DB_QUEUE DB_QUEUE_RETRY_AFTER QUEUE_FAILED_DRIVER
# UNUSED: BEANSTALKD_QUEUE_HOST BEANSTALKD_QUEUE BEANSTALKD_QUEUE_RETRY_AFTER
# UNUSED: SQS_PREFIX SQS_QUEUE SQS_SUFFIX
# UNUSED: SESSION_EXPIRE_ON_CLOSE SESSION_CONNECTION SESSION_TABLE SESSION_STORE SESSION_COOKIE SESSION_PARTITIONED_COOKIE
#
#  DB_SSLMODE is NOT in this list and NOT set above on purpose: `prefer` is
#  libpq's default and the dangerous one - it tries TLS and silently uses
#  plaintext if the server says no. Production must set `require` or
#  `verify-full`, and the boot guard refuses to start without it. It is absent
#  here because a local cluster has no certificate, and a key present with an
#  unsafe value reads as a reviewed choice.
# UNUSED: DB_SSLMODE

# =============================================================================
#  Keys set above that no file in config/ reads
# =============================================================================
#  The mirror of the block before it. `bin/verify config` also requires every
#  key SET above to be read by a config file or named here - otherwise a key
#  whose config entry was deleted sits in this file for years, and the next
#  person sets it and wonders why nothing happens.
#
#  Read by the framework itself rather than through a published config file:
# SET-ONLY: PHP_CLI_SERVER_WORKERS  `artisan serve` reads it directly
# SET-ONLY: BCRYPT_ROUNDS           the hasher reads it; config/hashing.php is not published
# SET-ONLY: BROADCAST_CONNECTION    the broadcast manager's default; config/broadcasting.php is not published
#
#  Set ahead of the config file that will read it, with the task that adds it:
# SET-ONLY: SCOUT_DRIVER      PF-072 - global search. `null` until there is an engine
# SET-ONLY: MEILISEARCH_HOST  PF-072
# SET-ONLY: MEILISEARCH_KEY   PF-072
#
#  Read at BUILD time by vite.config.js rather than by any config file:
# SET-ONLY: PEAKFLOW_FETCH_FONTS  1 downloads IBM Plex at build time and self-hosts it. Off by
#                                 default: the download needs fonts.bunny.net, and a build
#                                 environment that denies that host would fail the whole build
#                                 rather than the font step. With it off the stack in
#                                 resources/css/app.css falls back to each platform's own Arabic
#                                 UI face - the layout holds, the typography is not IBM Plex.

# ---------------------------------------------------------------------------
# Attachments - PF-073
# ---------------------------------------------------------------------------
# A disk of its own, never the public one: the objects are tax documents and
# the public disk is served with no signature and no expiry.
ATTACHMENTS_DISK=attachments
ATTACHMENTS_DRIVER=local
ATTACHMENTS_PREFIX=attachments

# An upload path with no cap is a way to fill the disk, and a full disk stops
# the ledger accepting postings.
ATTACHMENTS_MAX_BYTES=26214400

# A separate host, so a stored HTML or SVG file cannot execute where the
# session cookie is. Empty in development; production refuses to be empty.
ATTACHMENTS_ORIGIN=

# Five minutes. A link ends up in a browser history, a chat message and a
# support ticket.
ATTACHMENTS_URL_TTL=300

# `clamav` runs clamdscan; `unavailable` stores the file and leaves it
# unreadable. There is deliberately no driver that accepts everything.
ATTACHMENTS_SCANNER=unavailable
CLAMDSCAN_BINARY=clamdscan
CLAMDSCAN_TIMEOUT=60

# ---------------------------------------------------------------------------
# The archive - PF-129
# ---------------------------------------------------------------------------
# Its own disk, separate from attachments: the two have different retention
# and different deletion rules.
ARCHIVE_DISK=archive
ARCHIVE_DRIVER=local
ARCHIVE_PREFIX=archive

# Whether the bucket has object-lock in compliance mode. It cannot be turned
# on after a bucket exists, and production refuses to run without it.
ARCHIVE_OBJECT_LOCK=false

# How many artefacts a restore drill takes. Random each time.
ARCHIVE_DRILL_SAMPLE=10
