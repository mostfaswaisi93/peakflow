#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 |-----------------------------------------------------------------------------
 | bin/verify - the checks, without a test runner
 |-----------------------------------------------------------------------------
 |
 | Runs the architecture rules and the specification's worked examples against
 | the real code, using nothing but the application's own autoloader.
 |
 | It exists because the dev dependencies could not be installed in the
 | environment PeakFlow was first assembled in, and "we could not run the
 | checks" is not an acceptable state for a financial system. The same rules
 | are wrapped by PHPUnit tests in tests/Architecture and tests/Unit, so in a
 | normal environment they run there too - one implementation, two runners.
 |
 |   php bin/verify            everything
 |   php bin/verify arch       architecture rules only (source files)
 |   php bin/verify wiring     wiring rules only (the booted application)
 |   php bin/verify tenant     what the tenant database actually enforces
 |   php bin/verify rollback   provisioning rollback, by injecting a failure at each step (slow)
 |   php bin/verify concurrency  gapless numbering under 20 parallel issuers (slow, writes data)
 |   php bin/verify public     the customer-facing quote link, over real HTTP (writes data)
 |   php bin/verify api        the REST contract, over real HTTP (writes data, spawns workers)
 |   php bin/verify ledger     what the ledger refuses
 |   php bin/verify parties    the controls around party bank details
 |   php bin/verify currency   what the currency and FX layer refuses
 |   php bin/verify numbering  what a numbering series guarantees
 |   php bin/verify terms      what payment terms produce
 |   php bin/verify catalog    items, and which price wins
 |   php bin/verify settings   what a tenant may and may not decide
 |   php bin/verify queue      the tenant travels with the job
 |   php bin/verify grid       the data grid, its keyboard model and the form system
 |   php bin/verify identity   what a sign-in has to prove before it is a session
 |   php bin/verify iso        the vendored standards data, and what it is allowed to say
 |   php bin/verify iban       IBANs and domestic bank identifiers, and what they refuse
 |   php bin/verify canonical  canonical JSON and XML, and the hashes that depend on them
 |   php bin/verify roles      what each database role can actually reach
 |   php bin/verify config     .env.example completeness, and the settings production may not get wrong
 |   php bin/verify lang       ICU messages, and the sentences Arabic will not let you assemble
 |   php bin/verify design     the colour tokens, and the contrast all five themes must keep
 |   php bin/verify design-system  the token layers, the focus indicator, type, digits and density
 |   php bin/verify reporting  the Overview: what it counts, and what it costs
 |   php bin/verify errors     what a failure looks like from outside
 |   php bin/verify observability  the traces, the metrics, and the alerts on the invariants
 |   php bin/verify hardening  what the XML, upload, header and privilege hardening refuses
 |   php bin/verify repo       the commit hook, composer setup, and the laptop setup
 |   php bin/verify ops        the tenant lifecycle on screen, and what it refuses
 |   php bin/verify tax        tax categories, and rates that are effective-dated
 |   php bin/verify charts     the chart templates, and the charts they produce
 |   php bin/verify sales      the invoice: what a draft refuses, and what issuing guarantees
 |   php bin/verify banking    bank accounts, balances, statements, what a bank sends, and matching
 |   php bin/verify settlement payments, allocations and the payment file
 |   php bin/verify stock      stock movements, cost of sales and the inventory tie
 |   php bin/verify property   the balanced-entry invariant over generated entries
 |   php bin/verify group      inter-entity postings across a four-entity group
 |   php bin/verify manual     manual journal entry: validation, templates, import
 |   php bin/verify logging    what a log line may and may not contain
 |   php bin/verify examples   worked examples only
 |
 | Exits non-zero on any violation.
 */

$base = dirname(__DIR__);

require $base.'/vendor/autoload.php';

// The worked examples read config('money.*'), so the application has to boot.
$app = require $base.'/bootstrap/app.php';
$app->make(Illuminate\Contracts\Console\Kernel::class)->bootstrap();

// tests/ is in autoload-dev, which may not be dumped. Register it directly so
// bin/verify works against an optimized production autoloader too.
spl_autoload_register(static function (string $class) use ($base): void {
    if (! str_starts_with($class, 'Tests\\')) {
        return;
    }

    $path = $base.'/tests/'.str_replace('\\', '/', substr($class, 6)).'.php';

    if (is_file($path)) {
        require $path;
    }
});

$only = $argv[1] ?? 'all';

$suites = [];

/*
 | A suite that throws must FAIL, not silence the run.
 |
 | Every suite's rules are evaluated eagerly while this array is built, so an
 | exception thrown while building one used to abort bin/verify before the
 | runner printed a single line: every other suite went quiet because one
 | configuration file was contradictory.
 |
 | Found while proving that PF-078's bloc membership check bites. The
 | deliberate contradiction - the United Kingdom listed as both an EU member
 | and a departure - was refused exactly as designed, and the refusal took the
 | whole run with it. A green run and an aborted run are easy to tell apart;
 | an aborted run and a run that checked 23 things are not.
 |
 | The exception becomes a failed check carrying its message, and the suites
 | after it still run.
 */
$suite = static function (callable $build): array {
    try {
        return $build();
    } catch (Throwable $e) {
        return ['the suite could not be built, so nothing in it was checked' => [sprintf(
            '%s: %s',
            $e::class,
            preg_replace('/\s+/', ' ', $e->getMessage()) ?? '(no message)',
        )]];
    }
};

if ($only === 'all' || $only === 'arch') {
    $suites['Architecture rules'] = $suite(static fn (): array => (new Tests\Support\ArchitectureRules($base))->all());
}

if ($only === 'all' || $only === 'wiring') {
    $suites['Wiring'] = $suite(static fn (): array => (new Tests\Support\WiringRules($app))->all());
}

/*
 | Not in `all`: it provisions five times, each creating and dropping a real
 | database and role. Slow and cluster-writing checks that run on every quick
 | verify are checks people stop running.
 */
/*
 | Not in `all`, for the same reasons as `rollback`: it writes committed data
 | - its workers are separate processes and cannot see a transaction this one
 | holds open - and it spawns twenty of them.
 */
/*
 | Not in `all`: it drives real HTTP requests, and the first thing the tenant
 | middleware does is purge the tenant connection - which abandons the
 | transaction a suite would hold and takes its fixture with it. So this one
 | commits its fixture and tears it down afterwards.
 */
if ($only === 'public') {
    $suites['The public quote link'] = $suite(static fn (): array => (new Tests\Support\PublicQuoteRules())->all());
}

if ($only === 'concurrency') {
    $suites['The gapless proof'] = $suite(static fn (): array => (new Tests\Support\ConcurrencyRules())->all());
}

/*
 | Not in `all`, for the same reasons as `public` and `concurrency`: it
 | drives real HTTP, commits its fixture rather than holding a transaction
 | open - its workers are separate processes and cannot see one - and it
 | spawns two of them to prove that one idempotency key produces one entry.
 */
